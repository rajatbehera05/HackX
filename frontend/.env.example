# Frontend Environment Variables
# In local development: /api (proxied via Vite to http://localhost:5000)
# In production (e.g. Vercel): https://your-backend-app.onrender.com/api
VITE_API_URL=/api

# Supabase Project Configuration (Auth & Database)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
